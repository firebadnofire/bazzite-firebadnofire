FROM quay.io/fedora/fedora-bootc:44@sha256:6718b0634e138d1909e752dc0f7d8a203ede6ece33bc637f72282bde3d44887b

# Keep the boot environment focused on installation. The workstation image is
# deliberately not an input to this build and is pulled only after ISO boot.
# The Fedora bootc base is general-purpose, so remove emulators, desktop GPU
# firmware, fwupd, and toolbox that an x86_64 text installer cannot use.
RUN dnf5 -y --setopt=install_weak_deps=False install \
        anaconda-core \
        anaconda-dracut \
        anaconda-tui \
        dracut-config-generic \
        dracut-network \
        grub2-efi-x64-cdboot \
        isomd5sum \
        net-tools \
        plymouth \
        squashfs-tools \
        tmux \
        xorriso \
    && dnf5 -y remove \
        'qemu-user-static*' \
        amd-gpu-firmware \
        fwupd \
        intel-gpu-firmware \
        nvidia-gpu-firmware \
        toolbox \
    && dnf5 clean all \
    && rm -rf /var/cache/dnf

COPY network-installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY network-installer/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
COPY network-installer/patch-anaconda-progress.py /usr/libexec/patch-anaconda-progress
COPY system_files/etc/containers/registries.conf.d/20-bazzite-firebadnofire-mirror.conf \
    /etc/containers/registries.conf.d/20-bazzite-firebadnofire-mirror.conf

# These are the minimum container-to-installer adaptations currently required
# by upstream Image Builder's bootc-generic-iso contract.
# The no-hostonly initramfs carries firmware for boot-time hardware, so the live
# squashfs does not duplicate it. Keep the module tree available after the
# switch-root, when installer services can still request additional modules.
# The installer is English-only.
# Attach tmux explicitly: anaconda.service starts only the background session.
# Serial PTYs also need an active guest-side terminal service.
RUN set -Eeuo pipefail; \
    python /usr/libexec/patch-anaconda-progress; \
    rm -f /usr/libexec/patch-anaconda-progress; \
    install -d -m 0755 /boot/efi /var/mnt; \
    cp -a /usr/lib/efi/*/*/EFI /boot/efi/; \
    printf '%s\n' 'install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda' \
        >> /etc/passwd; \
    printf '%s\n' 'install::14438:0:99999:7:::' >> /etc/shadow; \
    passwd -d root; \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives; \
    mv /etc/yum.repos.d /etc/anaconda.repos.d; \
    ln -sfn /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target; \
    install -d -m 0755 /etc/systemd/system/anaconda.target.wants; \
    for tty in tty1 ttyS0; do \
        ln -sfn /usr/lib/systemd/system/anaconda-tmux@.service \
            "/etc/systemd/system/anaconda.target.wants/anaconda-tmux@${tty}.service"; \
    done; \
    ln -sfn /usr/lib/systemd/system/anaconda-shell@.service \
        /etc/systemd/system/anaconda.target.wants/anaconda-shell@tty2.service; \
    ln -sfn /dev/null /etc/systemd/system/serial-getty@ttyS0.service; \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator; \
    ln -sfn /usr/lib/systemd/system/anaconda-shell@.service \
        /usr/lib/systemd/system/autovt@.service; \
    install -d -m 0755 /usr/lib/systemd/logind.conf.d; \
    printf '%s\n' '[Login]' 'ReserveVT=2' \
        > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf; \
    mkdir -p "$(realpath /root)"; \
    kernel="$(kernel-install list --json pretty | \
        jq -r '.[] | select(.has_kernel == true) | .version')"; \
    test -n "${kernel}"; \
    DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
        --add 'anaconda' "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"; \
    rm -rf \
        /usr/lib/firmware \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/locale/* \
        /sysroot/ostree/repo \
        /var/cache/* \
        /var/log/* \
        /var/tmp/*; \
    find /usr/lib/locale -mindepth 1 -maxdepth 1 ! -name C.utf8 \
        -exec rm -rf -- {} +; \
    command -v anaconda; \
    command -v bootc; \
    command -v grub2-mkimage; \
    command -v implantisomd5; \
    command -v mksquashfs; \
    command -v podman; \
    command -v python; \
    command -v xorriso; \
    test -s /usr/lib/systemd/system/anaconda-tmux@.service; \
    test -s /usr/lib/systemd/system/anaconda-shell@.service; \
    for tty in tty1 ttyS0; do \
        test -s "/etc/systemd/system/anaconda.target.wants/anaconda-tmux@${tty}.service"; \
    done; \
    bootc --help >/dev/null; \
    test ! -e /sysroot/ostree/repo; \
    test -s /usr/share/anaconda/interactive-defaults.ks
