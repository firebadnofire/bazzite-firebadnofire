#!/usr/bin/bash

set -Eeuo pipefail

: "${HOME:?HOME must be set before starting Hyprland}"

readonly config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly config_dir="${config_home}/hypr"
readonly defaults_dir="/usr/share/bazzite-firebadnofire"

install -d -m 0700 "${config_dir}"

# Never replace an operator's Hyprland configuration. A legacy .lua also
# counts as an existing choice because Hyprland supports both formats.
if [[ ! -e "${config_dir}/hyprland.lua" && ! -e "${config_dir}/hyprland.conf" ]]; then
    install -m 0600 "${defaults_dir}/hyprland.conf" "${config_dir}/hyprland.conf"
fi

for name in hypridle.conf hyprlock.conf hyprpaper.conf; do
    if [[ ! -e "${config_dir}/${name}" ]]; then
        install -m 0600 "${defaults_dir}/${name}" "${config_dir}/${name}"
    fi
done

readonly waybar_dir="${config_home}/waybar"
install -d -m 0700 "${waybar_dir}"
if [[ ! -e "${waybar_dir}/config.jsonc" && ! -e "${waybar_dir}/config" ]]; then
    install -m 0600 "${defaults_dir}/waybar/config.jsonc" "${waybar_dir}/config.jsonc"
fi

install -d -m 0700 "${config_home}/wallpapers"

exec /usr/bin/Hyprland
